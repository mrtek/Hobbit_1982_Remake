[node name="QuoteText" type="Label" parent="ScrollArea/ScrollContent/TextVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 0.9)
theme_override_constants/line_spacing = 6
theme_override_font_sizes/font_size = 20
text = "«В норе под землёй жил хоббит.
Не в сырой и затхлой норе, где полно червей,
и не в сухой песчаной, где не на что сесть...
Это была хоббичья нора, а значит — уютная во всех отношениях.»"
